{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short Storyboard",
  "type": "object",
  "required": [
    "title",
    "language",
    "style",
    "characters",
    "shots",
    "music"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "description": "Narration language, e.g. am, om, ti, so, en"
    },
    "audience": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "style": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "reference_image": {
          "type": "string"
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reference_image": {
            "type": "string"
          },
          "real_person": {
            "type": "boolean"
          },
          "consent_ref": {
            "type": "string",
            "description": "Pointer to the consent record in ETHICS.md"
          },
          "seed": {
            "type": "integer"
          },
          "based_on": {
            "type": "string",
            "description": "Character whose reference sheet is an input image for this one"
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_s",
          "reason",
          "image_prompt",
          "motion_prompt",
          "narration",
          "subtitle_en",
          "speaker"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "duration_s": {
            "type": "number",
            "minimum": 2,
            "maximum": 15
          },
          "reason": {
            "type": "string",
            "description": "Why this shot exists"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_prompt": {
            "type": "string"
          },
          "motion_prompt": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "subtitle_en": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "music_cue": {
            "type": "string"
          },
          "speaker": {
            "type": "string",
            "description": "Key in voices: narrator, mom, child"
          },
          "delivery": {
            "type": "string",
            "description": "How the line should feel. NOT sent to TTS (E02: the model reads directions aloud); guides voice choice, punctuation and user-test listening."
          },
          "tts_tag": {
            "type": "string",
            "description": "Short emotion tag sent to TTS as '[tag] line' (e.g. angry, sarcastic). Not shown in subtitles."
          },
          "keyframe_from": {
            "type": "string",
            "description": "Reuse another shot's keyframe (a cutaway with a different camera move) instead of generating one"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "lyrics": {
          "type": "string"
        },
        "bpm": {
          "type": "integer"
        },
        "chosen": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "prompt",
              "seed"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "seed": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "end_card": {
      "type": "string",
      "default": "Made with AI"
    },
    "voices": {
      "type": "object",
      "description": "speaker id -> Gemini TTS prebuilt voice name",
      "additionalProperties": {
        "type": "string"
      }
    },
    "subtitle_language": {
      "type": "string"
    },
    "end_card_duration_s": {
      "type": "number",
      "minimum": 2,
      "maximum": 6
    },
    "format": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    }
  }
}