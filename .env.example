# Copy to .env and fill in. Never commit .env.

# Google AI Studio -> Get API key
GEMINI_API_KEY=
# Optional extra keys from other projects, used when the first hits its daily quota
GEMINI_API_KEY2=

# Cloudflare dashboard -> Account ID (right sidebar) and
# My Profile -> API Tokens -> Create token -> "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=

# kaggle.com -> Settings -> API -> Create New Token (opens kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional second Kaggle account (used for Wan video so it runs in parallel with music)
KAGGLE_USERNAME2=
KAGGLE_KEY2=

# Model IDs. Override if a provider renames them; `python scripts/smoke_test.py --list-models` shows Gemini's.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACK=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK=gemini-3.8-flash-lite-tts
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
